{
  "name": "bs-translator",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "web",
    "worker"
  ],
  "scripts": {
    "build": "npm run build -w web",
    "dev": "wrangler dev",
    "dev:web": "npm run dev -w web",
    "deploy": "wrangler deploy",
    "typecheck": "npm run typecheck -w worker && npm run typecheck -w web",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "wrangler": "^4.151.1"
  }
}
