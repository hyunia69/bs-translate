{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bs-translate",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["enable_request_signal"],
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DUAL_HUB", "class_name": "DualHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DualHub"] }],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "8790",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    "CLIENT_SECRET_TTL_SECONDS": "600"
  },
  "observability": { "enabled": true },
  "dev": { "port": 8790 }
  // Secrets (never in this file): OPENAI_API_KEY, APP_PIN -> `wrangler secret put`, locally .dev.vars.
}
