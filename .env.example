# OpenAI API key. Server only. Never put it in web/ or commit it.
# The server also reads .env.local (its values win over .env); there the key may be named `chatgptkey`.
OPENAI_API_KEY=

# 4-6 digit PIN required before the server issues session tokens.
APP_PIN=

# HTTP port for the Fastify server (serves the API and the built web app).
PORT=8787
# Bind address. 0.0.0.0 to accept LAN connections, 127.0.0.1 behind a reverse proxy on the same host.
HOST=0.0.0.0

# Client secret lifetime in seconds (10-7200).
CLIENT_SECRET_TTL_SECONDS=600

# Max token requests per minute per IP.
SESSION_RATE_LIMIT_PER_MIN=30

# Save conversation history on the server as JSON (true/false). Default off.
SAVE_TRANSCRIPTS=false
# Directory for transcripts and latency logs.
DATA_DIR=./data
